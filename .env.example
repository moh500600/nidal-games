# Backend (copy to backend/.env or export)
DEBUG=1
SECRET_KEY=change-me-to-a-random-string-of-50+-chars
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# PostgreSQL (if POSTGRES_DB is unset, SQLite is used for local dev)
POSTGRES_DB=nidal
POSTGRES_USER=nidal
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional provider keys (server-side only, never shipped to clients). Check provider terms first.
RAWG_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
